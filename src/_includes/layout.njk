<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Locus Bodyworks" }}</title>
  <meta name="description" content="{{ description or "Massage therapy, sports massage, and yoga therapy with Tatiana Armstrong in Durango, Colorado." }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Albert+Sans:ital,wght@0,400;0,700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,200;12..96,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="{{ 'dark-header' if page.url == '/contact/' }}">

  <header class="site-header">
    <div class="site-header-inner">
      <a class="brand fade-in" href="/">
        <img class="brand-logo brand-logo-dark" src="/images/locus-bodyworks-logo.png" alt="Locus Bodyworks">
        <img class="brand-logo brand-logo-light" src="/images/locus-logo-white.png" alt="Locus Bodyworks">
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </button>
      <nav class="site-nav" id="site-nav">
        <a href="/massage-offerings/">Massage</a>
        <a href="/yoga/">Yoga</a>
        <a href="/#about">About</a>
        <a href="/contact/"{% if page.url == '/contact/' %} class="active"{% endif %}>Contact</a>
      </nav>
    </div>
    {% if page.url == '/contact/' %}
    <div class="contact-hero-copy">
      <h1 class="rise-in">Schedule a massage</h1>
      <h1 class="rise-in" style="animation-delay:.18s">Book a class</h1>
      <h1 class="rise-in" style="animation-delay:.31s">Join a workshop</h1>
    </div>
    {% endif %}
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <div class="footer-brand">
          <img class="footer-logo" src="/images/locus-logo-white.png" alt="Locus Bodyworks">
        </div>
        <div class="footer-rule"></div>
        <div class="footer-links">
          <div>
            <p><a class="footer-cta" href="/contact/">Contact // Book</a></p>
            <p class="footer-contact"><a href="tel:9703359309">(970) 335-9309</a><br>Durango, Colorado</p>
          </div>
          <div>
            <p class="footer-address">1129 Main Ave, Ste. 203</p>
            <p class="footer-hours">Hours<br>Monday – Friday<br>10am – 6pm</p>
          </div>
        </div>
      </div>

      <div class="footer-signup">
        <p>Sign up with your email address to receive news and updates.</p>
        <!--
          GOOGLE FORM EMAIL SIGNUP
          Replace YOUR_FORM_ID below with your real Google Form's URL.
          In Google Forms: Send > the link icon > copy the shareable URL,
          and paste it in below (the href on the Sign Up button).
        -->
        <a class="btn btn--outline" href="https://forms.gle/YCoKTKLtpHt3ndZz8" target="_blank" rel="noreferrer">Sign Up</a>
        <p class="footer-fine-print">We respect your privacy.</p>
      </div>
    </div>
    <div class="footer-bottom">
      <a href="https://book.squareup.com/appointments/s2jerio9fmb4mg/location/LEXQV8KBTGWRV/services" target="_blank" rel="noreferrer">Booking for Return Clients</a>
    </div>
  </footer>

  <script src="/js/main.js"></script>
  <script>
    document.querySelector(".nav-toggle").addEventListener("click", function () {
      document.body.classList.toggle("nav-open");
      this.setAttribute("aria-expanded", document.body.classList.contains("nav-open"));
    });
  </script>
</body>
</html>
