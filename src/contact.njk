<section class="contact-section">
  <div class="contact-info">
    <h2>Contact</h2>
    <p>To book a massage, you can <span class="hl hl-cream" style="animation-delay:.25s">book through Square.</span></p>
    <p><a class="btn" href="https://book.squareup.com/appointments/s2jerio9fmb4mg/location/LEXQV8KBTGWRV/services" target="_blank" rel="noreferrer">Book a massage</a></p>
    <p style="margin-top:2.5rem;">For yoga or other inquiries, please reach out:</p>
    <p class="label">Email</p>
    <p class="value"><a href="mailto:locusbodyworks@gmail.com">locusbodyworks@gmail.com</a></p>
    <p class="label">Call or text</p>
    <p class="value"><a href="tel:9703359309">(970) 335-9309</a></p>
    <div class="rule"></div>
    <p class="value">Durango, Colorado<br>1129 Main Ave, Ste. 203<br><br>Hours<br>Monday – Friday<br>10am – 6pm</p>
  </div>

  <div class="contact-form-panel">
    <form name="contact" method="POST" data-netlify="true" data-netlify-ajax netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="contact">
      <p hidden><label>Don't fill this out: <input name="bot-field"></label></p>
      <div class="field">
        <label for="email">Email <span class="req">(required)</span></label>
        <input id="email" name="email" type="email" required>
      </div>
      <div class="field">
        <label for="topic">What is this regarding? <span class="req">(required)</span></label>
        <select id="topic" name="topic" required>
          <option value="">Select an option</option>
          <option value="massage">Massage</option>
          <option value="yoga-therapy">Yoga therapy</option>
          <option value="classes">Classes &amp; workshops</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div class="field">
        <label for="message">Message <span class="req">(required)</span></label>
        <textarea id="message" name="message" rows="4" required></textarea>
      </div>
      <div class="send-row">
        <button class="btn" type="submit">Send</button>
        <span class="form-status" hidden>Thank you — I will be in touch soon.</span>
      </div>
    </form>
  </div>
</section>
